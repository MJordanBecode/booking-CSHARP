@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    ViewData["HideSearchBar"] = true;
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 flex items-center justify-center p-4">
    <div class="w-full max-w-6xl grid lg:grid-cols-2 gap-8 items-center">
        
        <!-- Section Hero (Desktop uniquement) -->
        <div class="hidden lg:flex flex-col justify-center space-y-8 px-8">
            <div class="space-y-6">
                <div class="space-y-2">
                    <h1 class="text-4xl font-bold text-slate-900 leading-tight">Bienvenue de retour !</h1>
                    <p class="text-xl text-slate-600">
                        Connectez-vous à votre compte pour accéder à toutes vos fonctionnalités.
                    </p>
                </div>

                <div class="space-y-4">
                    <div class="flex items-center space-x-3">
                        <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                            <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                        </div>
                        <span class="text-slate-700">Accès sécurisé à vos données</span>
                    </div>
                    <div class="flex items-center space-x-3">
                        <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                            <div class="w-3 h-3 bg-blue-500 rounded-full"></div>
                        </div>
                        <span class="text-slate-700">Synchronisation multi-appareils</span>
                    </div>
                    <div class="flex items-center space-x-3">
                        <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                            <div class="w-3 h-3 bg-purple-500 rounded-full"></div>
                        </div>
                        <span class="text-slate-700">Support client 24/7</span>
                    </div>
                </div>
            </div>

            <div class="relative">
                <img src="/placeholder.svg?height=300&width=400" alt="Login illustration" 
                     class="w-full max-w-md mx-auto rounded-2xl shadow-lg" />
            </div>
        </div>

        <!-- Section Formulaire -->
        <div class="w-full max-w-md mx-auto lg:mx-0">
            <div class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-2xl border-0 p-8">
                
                <!-- Header -->
                <div class="text-center space-y-2 mb-8">
                    <h2 class="text-2xl font-bold text-slate-900">@ViewData["Title"]</h2>
                    <p class="text-slate-600">Utilisez votre compte local pour vous connecter</p>
                </div>

                <!-- Formulaire principal -->
                <div class="space-y-6">
                    <form id="account" method="post" class="space-y-4">
                        <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm" role="alert"></div>
                        
                        <!-- Email -->
                        <div class="space-y-2">
                            <label asp-for="Input.Email" class="block text-sm font-medium text-slate-700">Email</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                                    </svg>
                                </div>
                                <input asp-for="Input.Email" 
                                       class="block w-full pl-10 pr-3 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" 
                                       autocomplete="username" 
                                       aria-required="true" 
                                       placeholder="nom@exemple.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-red-600 text-sm"></span>
                        </div>

                        <!-- Password -->
                        <div class="space-y-2">
                            <label asp-for="Input.Password" class="block text-sm font-medium text-slate-700">Mot de passe</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                    </svg>
                                </div>
                                <input asp-for="Input.Password" 
                                       class="block w-full pl-10 pr-3 py-3 border border-slate-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" 
                                       autocomplete="current-password" 
                                       aria-required="true" 
                                       placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-red-600 text-sm"></span>
                        </div>

                        <!-- Remember Me -->
                        <div class="flex items-center">
                            <input class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-slate-300 rounded" 
                                   asp-for="Input.RememberMe" />
                            <label asp-for="Input.RememberMe" class="ml-2 block text-sm text-slate-600 cursor-pointer">
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>

                        <!-- Submit Button -->
                        <button id="login-submit" type="submit" 
                                class="w-full py-3 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-medium rounded-lg transition-all duration-200 transform hover:scale-[1.02] focus:ring-4 focus:ring-blue-200">
                            Se connecter
                        </button>
                    </form>

                    <!-- Links -->
                    <div class="space-y-4">
                        <div class="text-center">
                            <a id="forgot-password" asp-page="./ForgotPassword" 
                               class="text-sm text-blue-600 hover:text-blue-800 hover:underline transition-colors">
                                Mot de passe oublié ?
                            </a>
                        </div>

                        <div class="text-center space-y-2">
                            <span class="text-sm text-slate-600">Pas encore de compte ? </span>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" 
                               class="text-sm text-blue-600 hover:text-blue-800 hover:underline font-medium transition-colors">
                                Créer un compte
                            </a>
                        </div>

                        <div class="text-center">
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" 
                               class="text-xs text-slate-500 hover:text-slate-700 hover:underline transition-colors">
                                Renvoyer la confirmation par email
                            </a>
                        </div>
                    </div>

                    <!-- External Logins -->
                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <div class="space-y-4">
                            <div class="relative">
                                <div class="absolute inset-0 flex items-center">
                                    <div class="w-full border-t border-slate-200"></div>
                                </div>
                                <div class="relative flex justify-center text-xs uppercase">
                                    <span class="bg-white px-2 text-slate-500">Ou continuer avec</span>
                                </div>
                            </div>

                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                <div class="grid gap-3">
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit" 
                                                class="w-full flex items-center justify-center px-4 py-3 border border-slate-200 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition-colors focus:ring-2 focus:ring-blue-500" 
                                                name="provider" 
                                                value="@provider.Name" 
                                                title="Se connecter avec votre compte @provider.DisplayName">
                                            @provider.DisplayName
                                        </button>
                                    }
                                </div>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
                            <p class="text-sm text-amber-800">
                                Aucun service d'authentification externe n'est configuré. 
                                <a href="https://go.microsoft.com/fwlink/?LinkID=532715" 
                                   class="underline hover:no-underline" 
                                   target="_blank">
                                    Voir cet article
                                </a> 
                                pour configurer cette application ASP.NET.
                            </p>
                        </div>
                    }
                </div>
            </div>

            <!-- Hero mobile -->
            <div class="lg:hidden mt-8 text-center space-y-4">
                <h2 class="text-2xl font-bold text-slate-900">Bienvenue de retour !</h2>
                <p class="text-slate-600">Connectez-vous pour accéder à toutes vos fonctionnalités.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}