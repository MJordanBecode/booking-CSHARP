
@model Solution.Models.Offer

@{
    ViewData["Title"] = "Créer une offre";
    ViewData["HideSearchBar"] = true;
}

<div class="max-w-2xl mx-auto mt-10 p-6 bg-white rounded-2xl shadow-md">
    <h1 class="text-2xl font-bold mb-6">@ViewData["Title"]</h1>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-4">
        <div>
            <label asp-for="Title" class="block text-sm font-medium">Titre</label>
            <input asp-for="Title" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring focus:ring-indigo-300" />
            <span asp-validation-for="Title" class="text-red-500 text-sm" />
        </div>

        <div>
            <label asp-for="Description" class="block text-sm font-medium">Description</label>
            <textarea asp-for="Description" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:ring focus:ring-indigo-300"></textarea>
            <span asp-validation-for="Description" class="text-red-500 text-sm" />
        </div>

        <div>
            <label asp-for="Location" class="block text-sm font-medium">Emplacement</label>
            <input asp-for="Location" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
            <span asp-validation-for="Location" class="text-red-500 text-sm" />
        </div>

        <div>
            <label asp-for="Type" class="block text-sm font-medium">Type</label>
            <input asp-for="Type" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
            <span asp-validation-for="Type" class="text-red-500 text-sm" />
        </div>

        <div class="grid grid-cols-3 gap-4">
            <div>
                <label asp-for="BedNumber" class="block text-sm font-medium">Chambres</label>
                <input asp-for="BedNumber" type="number" min="0" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
                <span asp-validation-for="BedNumber" class="text-red-500 text-sm" />
            </div>
            <div>
                <label asp-for="BathNumber" class="block text-sm font-medium">Salles de bain</label>
                <input asp-for="BathNumber" type="number" min="0" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
                <span asp-validation-for="BathNumber" class="text-red-500 text-sm" />
            </div>
            <div>
                <label asp-for="NumberOfRooms" class="block text-sm font-medium">Pièces</label>
                <input asp-for="NumberOfRooms" type="number" min="0" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
                <span asp-validation-for="NumberOfRooms" class="text-red-500 text-sm" />
            </div>
        </div>

        <div>
            <label asp-for="Price" class="block text-sm font-medium">Prix</label>
            <input asp-for="Price" type="number" step="0.01" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
            <span asp-validation-for="Price" class="text-red-500 text-sm" />
        </div>

        <div>
            <label asp-for="Image" class="block text-sm font-medium">Image (URL ou chemin)</label>
            <input type="file" asp-for="Image" id="ImageFile" name="ImageFile" accept="image/*" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" />
            <span asp-validation-for="Image" class="text-red-500 text-sm" />
        </div>

        <button type="submit" class="w-full bg-indigo-600 text-white py-2 px-4 rounded-xl hover:bg-indigo-700 transition">
            Créer l'offre
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
