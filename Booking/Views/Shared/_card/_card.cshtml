@model Booking.Models.Offer

<div class="card w-full max-w-xs mb-4 sm:max-w-sm md:max-w-md lg:max-w-lg xl:max-w-xl mx-auto rounded-2xl shadow-md overflow-hidden border border-gray-200 hover:shadow-xl transition-shadow duration-300">
    <!-- Image -->
    <div class="relative h-56 sm:h-64 md:h-72 w-full bg-gray-100 flex items-center justify-center">
        <img src="@Url.Content("~/" + Model.Image)" alt="@Model.Title" class="max-h-full max-w-full object-contain" />

        <!-- Note (rating) -->
        <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-xl flex items-center gap-1 shadow-md">
            <i data-lucide="star" class="w-4 h-4 text-yellow-500 fill-current"></i>
            <span class="text-sm font-semibold text-gray-800">@Model.Note</span>
        </div>
        <!-- Like button -->
        <button class="absolute top-3 right-3 bg-white/90 p-2 rounded-full shadow hover:bg-white transition-colors group">
            <i data-lucide="heart" class="w-5 h-5 text-gray-600 group-hover:text-red-500"></i>
        </button>
    </div>
    <!-- Content -->
    <div class="bg-white p-4 sm:p-5 space-y-3">
        <!-- Title and Location -->
        <div>
            <h3 class="text-lg sm:text-xl font-bold text-gray-900 leading-tight">@Model.Title</h3>
            <p class="text-sm text-gray-500 mt-1">@Model.Location</p>
        </div>
        <!-- Details: beds, baths, rooms -->
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-700">
            <p class="flex items-center gap-1">
                <i data-lucide="bed" class="w-4 h-4 text-blue-500"></i>
                <span>@Model.BedNumber</span>
            </p>
            <p class="flex items-center gap-1">
                <i data-lucide="bath" class="w-4 h-4 text-blue-500"></i>
                <span>@Model.BathNumber</span>
            </p>
            <p class="flex items-center gap-1">
                <i data-lucide="house" class="w-4 h-4 text-blue-500"></i>
                <span>@Model.NumberOfRooms</span>
            </p>
        </div>
        <!-- Prices -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mt-2 pt-2 border-t border-gray-100">
            <p class="text-base font-semibold text-blue-600">€@Model.Price / nuit</p>
            <p class="text-sm font-semibold text-gray-600 mt-1 sm:mt-0">Total: €@(Model.Price * 7) (ex: 7 nuits)</p> @* Remplacez 7 par votre logique de calcul de jours *@
        </div>
        <!-- View Details -->
        <div class="pt-2 flex justify-end">
            <a href="@Url.Action("Details", "Offers", new { id = Model.Id })"
               class="inline-flex items-center gap-1 text-blue-600 text-sm font-medium hover:underline hover:text-blue-700 transition-colors">
                <i data-lucide="eye" class="w-4 h-4"></i>
                Voir plus
            </a>
        </div>
    </div>
</div>