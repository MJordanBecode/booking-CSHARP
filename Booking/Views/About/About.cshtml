@model string

@{
    ViewBag.Title = "About Us";
    Layout = "_Layout";
    ViewData["HideSearchBar"] = true;
}

<section class="max-w-5xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-center mb-8">About Us</h1>

    <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
            <p class="text-lg leading-relaxed text-gray-700 mb-4">
                Welcome to our booking platform! We specialize in helping you find and reserve the perfect place for your stay, whether it's a quick weekend getaway or a long-term trip.
            </p>
            <p class="text-lg leading-relaxed text-gray-700 mb-4">
                Our mission is to simplify travel planning and provide you with a seamless, reliable, and secure booking experience. We work with trusted partners and local hosts to ensure every stay is memorable.
            </p>
            <p class="text-lg leading-relaxed text-gray-700">
                Thank you for choosing us. We’re excited to help you plan your next adventure.
            </p>
        </div>

        <div>
            <img src="/images/avatarUser/stitch.png" alt="Team working together" class="rounded-2xl shadow-lg w-full">
        </div>
    </div>
</section>